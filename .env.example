# Copie para .env e preencha apenas se quiser ampliar os catálogos (opcional).
# Nunca comprometa o .env — ele está no .gitignore.

# Token do GitHub: eleva a Search/Releases API de 60 para 5.000 req/hora.
VITE_GITHUB_TOKEN=

# Chave da API comunitária do Winget (https://winget-pkg-api.onrender.com).
VITE_WINGET_API_KEY=
