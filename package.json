{
  "name": "carsaistore",
  "version": "1.0.0",
  "private": true,
  "description": "Carsai Store — loja de aplicativos agregadora (Android, iOS, Desktop) com cache local e download direto. TypeScript + Capacitor.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/file-transfer": "latest-7",
    "@capacitor/filesystem": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0"
  }
}
